# API Configuration
# In production: set this to your Railway backend URL (no trailing slash)
# Example: VITE_API_URL=https://urbanthread-backend.up.railway.app
VITE_API_URL=http://localhost:5001

# WhatsApp Business Configuration
# Enter phone number in international format without '+' or spaces
# Example for Sri Lanka: 94770000000
VITE_WHATSAPP_NUMBER=94770000000
