# Server
PORT=5001

# Database (Railway MySQL / local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=urbanthread_db

# JWT Authentication (use a long random string in production)
JWT_SECRET=

# PayHere Sandbox Credentials
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX_URL=https://sandbox.payhere.lk/pay/checkout

# Deployment URLs (no trailing slash)
# Set FRONTEND_URL to your Vercel deployment URL in production
FRONTEND_URL=http://localhost:5173
# Set BACKEND_URL to your Railway deployment URL in production
BACKEND_URL=http://localhost:5001

# Admin seed script (optional overrides for node src/scripts/seedAdmin.js)
ADMIN_EMAIL=admin@urbanthread.com
ADMIN_PASSWORD=
ADMIN_NAME=UrbanThread Admin

# WhatsApp Business Number (backend .env.example; actual number set in frontend)
WHATSAPP_NUMBER=
